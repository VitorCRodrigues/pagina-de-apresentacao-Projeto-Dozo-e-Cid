            "value": "Create monthly plan"
          }
        }
      }
    },
    "account.body.action_required": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para seguir con la apertura, enviá estos documentos. Los pide Interactive Brokers."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para continuar a abertura, envie estes documentos. Eles são pedidos pela Interactive Brokers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To continue opening your account, send these documents. Interactive Brokers asks for them."
          }
        }
      }
    },
    "account.body.draft": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retomá desde donde la dejaste: guardamos cada paso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de onde parou: salvamos cada etapa."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up where you left off: we saved every step."
          }
        }
      }
    },
    "account.body.open": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta en Interactive Brokers ya está a tu nombre. El próximo paso es crear tu plan mensual."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta na Interactive Brokers já está no seu nome. O próximo passo é criar seu plano mensal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Interactive Brokers account is now in your name. The next step is to create your monthly plan."
          }
        }
      }
    },
    "account.body.rejected": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisamos tu solicitud y no podemos abrir la cuenta en este momento. Si tenés preguntas, escribinos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisamos sua solicitação e não podemos abrir a conta neste momento. Se tiver dúvidas, fale com o suporte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We reviewed your application and cannot open the account at this time. If you have questions, contact support."
          }
        }
      }
    },
    "account.body.restricted": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ahora no podés hacer aportes. Tus inversiones siguen en Interactive Brokers, a tu nombre. Escribinos para resolverlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por enquanto você não pode fazer aportes. Seus investimentos continuam na Interactive Brokers, no seu nome. Fale com o suporte para resolver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now you cannot make deposits. Your investments remain at Interactive Brokers, in your name. Contact support to resolve this."
          }
        }
      }
    },
    "account.body.unknown": {
      "comment": "iOS only. TODO(compliance): neutral text pending review.",
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver el detalle, actualizá la app o escribinos."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ver os detalhes, atualize o app ou fale com o suporte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To see the details, update the app or contact support."
          }
        }
      }
    },
    "account.body.waiting": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suele tardar algunos días hábiles. Te avisamos por e-mail cuando haya novedades."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Costuma levar alguns dias úteis. Avisamos por e-mail quando houver novidades."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It usually takes a few business days. We will email you when there is news."
          }
        }
      }
    },
