    "account.actions.createPlan": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear plan mensual"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar plano mensal"
          }
        },
        "en": {
