    "help.questions.wrongNetwork.a" : {
      "comment" : "web: profile.json",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contact support right away with the transfer details. A wrong network can mean losing the funds: we cannot assure you they will be recovered, but we will review your case."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribinos enseguida a soporte con los datos del envío. Una red equivocada puede significar la pérdida de los fondos: no podemos asegurarte que se recuperen, pero vamos a revisar tu caso."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
