ast: 150ms;\n  --od-duration-base: 200ms;\n  --od-ease: cubic-bezier(0.2, 0, 0, 1);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :root {\n    --od-duration-fast: 0ms;\n    --od-duration-base: 0ms;\n  }\n}\n\n/*\n * Tailwind v4 theme. \"inline\" makes utilities point straight at the --od-* tokens above.\n * The default palette, radii and shadows are cleared, so only these tokens exist as classes.\n * Spacing keeps Tailwind's 4 px base (p-1 = 4 px, p-5 = 20 px).\n */\n@theme inline {\n  --color-*: initial;\n  --color-white: var(--od-white);\n  --color-paper: var(--od-paper);\n  --color-navy-50: var(--od-navy-50);\n  --color-navy-800: var(--od-navy-800);\n  --color-navy-900: var(--od-navy-900);\n  --color-green-50: var(--od-green-50);\n  --color-green-700: var(--od-green-700);\n  --color-gold-500: var(--od-gold-500);\n  --color-cream-50: var(--od-cream-50);\n  --color-graphite-900: var(--od-graphite-900);\n  --color-gray-50: var(--od-gray-50);\n  --color-gray-100: var(--od-gray-100);\n  --color-gray-200: var(--od-gray-200);\n  --color-gray-500: var(--od-gray-500);\n  --color-gray-600: var(--od-gray-600);\n  --color-amber-50: var(--od-amber-50);\n  --color-amber-700: var(--od-amber-700);\n  --color-brick-50: var(--od-brick-50);\n  --color-brick-700: var(--od-brick-700);\n\n  --font-serif: var(--od-font-serif);\n  --font-sans: var(--od-font-sans);\n  --font-mono: var(--od-font-mono);\n\n  --radius-*: initial;\n  --radius-control: var(--od-radius-control);\n  --radius-card: var(--od-radius-card);\n\n  --shadow-*: initial;\n  --shadow-hairline: var(--od-shadow-hairline);\n  --shadow-overlay: var(--od-shadow-overlay);\n\n  --transition-duration-fast: var(--od-duration-fast);\n  --transition-duration-base: var(--od-duration-base);\n  --ease-od: var(--od-ease);\n}\n"
